<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <Payload>$(MSBuildThisFileDirectory)../../src/AgentRelay.Windows/bin/Debug/net10.0-windows/win-x64/</Payload>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AgentRelay.Windows"><HintPath>$(Payload)AgentRelay.Windows.dll</HintPath></Reference>
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>$(Payload)Microsoft.Web.WebView2.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>$(Payload)Microsoft.Web.WebView2.WinForms.dll</HintPath></Reference>
    <Content Include="$(Payload)WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
